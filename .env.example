# Copy to .env on the server. All optional — the demo runs deterministically
# (zero LLM cost) without any keys.

# Control panel password (/control on the Globex site). Default: demo
CONTROL_PASSWORD=demo

# Set to run the agent on a real model (then pick the provider in /control).
# Any one is enough; leave the rest blank. Default model is Claude Haiku.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
